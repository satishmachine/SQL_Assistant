# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# =============================================================================
# IDEs & EDITORS
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml
*.iws

# Spyder
.spyderproject.cfg
.spyproject/

# Rope
.ropeproject/

# Sublime Text
*.sublime-project
*.sublime-workspace


# =============================================================================
# MISC
# =============================================================================
*.csv          # Exported query results — usually don't need to be committed
*.xlsx
*.json.bak
node_modules/  # In case any JS tooling is added later
